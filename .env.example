# Twelve-Factor Application Configuration Blueprint - Thatworkx AEO Suite
# Copy this file to .env or .env.development and fill in values. Do NOT commit secret keys.

# System & Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Infrastructure Connection Strings
MONGODB_URI=mongodb://127.0.0.1:27017/thatworkx-aeo

# Scan Quota Allocations & Daily Limits
AIV_FREE_MAX_SCANS=5
AIV_PRO_MAX_SCANS=50
AIV_FREE_MAX_PAGES=3
AIV_PRO_MAX_PAGES=40
AIO_PRO_MAX_HEADLESS=3
AIO_ENT_MAX_HEADLESS=10

# Third-Party Affiliate Network Referral Gateway URLs
SEMRUSH_AFFILIATE_URL=https://www.semrush.com/affiliate-redirect-placeholder

# ============================================
# EMAIL SERVICE (RESEND)
# ============================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=[resend-api-key-here]

# Email Configuration
FROM_EMAIL=noreply-dev@thatworkx.com
EMAIL_FROM_NAME=AEO Tools by Thatworkx - DEV

# Enable/disable email verification
ENABLE_EMAIL_VERIFICATION=true
